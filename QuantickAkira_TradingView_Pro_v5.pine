//@version=5
indicator("QuantickAkira - Spike Hunter & Harmonic Trading Lab Pro v5.0", shorttitle="QuantickAkira Pro", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// =============================================================================
// QUANTICKAKIRA // TRADINGVIEW PRO INSTITUTIONAL SUITE v5.0
// Diseñado para: Índices Sintéticos Deriv (Boom 1000/500/300, Crash 1000/500/300)
// y Mercados Financieros Generales (Forex, Cripto, Oro XAU/USD).
// =============================================================================

// -----------------------------------------------------------------------------
// 1. CONFIGURACIÓN GENERAL & FÍSICA DE MERCADO
// -----------------------------------------------------------------------------
grp_market = "1. Configuración de Mercado & Física de Índices"
market_mode = input.string("Auto", "Modo de Mercado", options=["Auto", "Boom (Solo Compras)", "Crash (Solo Ventas)", "Forex / Crypto / Oro (Bidireccional)"], group=grp_market, tooltip="Boom opera exclusivamente compras en spikes; Crash opera exclusivamente ventas.")
pip_size = input.float(0.01, "Tamaño de Pip/Punto", minval=0.00001, group=grp_market)

grp_spike = "2. Cazador Cuántico de Spikes (5 Vectores)"
enable_spike_hunter = input.bool(true, "Activar Cazador de Spikes", group=grp_spike)
sens_drift_1000 = input.int(7, "Deriva Mínima Boom/Crash 1000 (Velas)", minval=3, maxval=20, group=grp_spike)
sens_drift_500 = input.int(4, "Deriva Mínima Boom/Crash 500 (Velas)", minval=2, maxval=15, group=grp_spike)
sens_drift_300 = input.int(3, "Deriva Mínima Boom/Crash 300 (Velas)", minval=1, maxval=10, group=grp_spike)
wick_threshold_pct = input.float(22.0, "Umbral de Mecha de Absorción (%)", minval=10.0, maxval=50.0, group=grp_spike) / 100.0
compression_threshold = input.float(0.65, "Umbral de Micro-Consolidación ATR", minval=0.4, maxval=0.9, group=grp_spike)

grp_harmonic = "3. Escáner Armónico Automático (XABCD & PRZ)"
enable_harmonics = input.bool(true, "Activar Escáner Armónico", group=grp_harmonic)
zigzag_depth = input.int(10, "Profundidad ZigZag Extrema", minval=4, maxval=30, group=grp_harmonic)
fibo_tolerance = input.float(0.08, "Tolerancia de Ratios Fibonacci", minval=0.02, maxval=0.15, group=grp_harmonic)

grp_risk = "4. Gestión Asimétrica de Capital ($50 USD Base)"
account_balance = input.float(50.0, "Capital de Referencia ($ USD)", minval=10.0, group=grp_risk)
lot_size = input.float(0.20, "Lotaje Recomendado", minval=0.01, group=grp_risk)
sl_points = input.float(15.0, "Stop Loss en Puntos (1.0R)", minval=1.0, group=grp_risk)
show_target_boxes = input.bool(true, "Dibujar Cajas de Posición (SL/TP1/TP2/TP3)", group=grp_risk)
show_hud_table = input.bool(true, "Mostrar Panel HUD de Telemetría", group=grp_risk)

// -----------------------------------------------------------------------------
// 2. DETECCIÓN DETERMINISTA DEL MODO DE MERCADO
// -----------------------------------------------------------------------------
var is_boom = false
var is_crash = false
var is_general = false

ticker_upper = syminfo.ticker

if market_mode == "Auto"
    if str.contains(ticker_upper, "BOOM") or str.contains(ticker_upper, "B1000") or str.contains(ticker_upper, "B500") or str.contains(ticker_upper, "B300")
        is_boom := true
        is_crash := false
        is_general := false
    else if str.contains(ticker_upper, "CRASH") or str.contains(ticker_upper, "C1000") or str.contains(ticker_upper, "C500") or str.contains(ticker_upper, "C300")
        is_boom := false
        is_crash := true
        is_general := false
    else
        is_boom := false
        is_crash := false
        is_general := true
else if market_mode == "Boom (Solo Compras)"
    is_boom := true
    is_crash := false
    is_general := false
else if market_mode == "Crash (Solo Ventas)"
    is_boom := false
    is_crash := true
    is_general := false
else
    is_boom := false
    is_crash := false
    is_general := true

// Parámetros estocásticos de Poisson / Deriv
min_drift_req = str.contains(ticker_upper, "300") ? sens_drift_300 : (str.contains(ticker_upper, "500") ? sens_drift_500 : sens_drift_1000)
avg_interval = str.contains(ticker_upper, "300") ? 5.0 : (str.contains(ticker_upper, "500") ? 9.0 : 16.6)

// -----------------------------------------------------------------------------
// 3. MOTOR DE 5 VECTORES DE CAZA DE SPIKES (BOOM & CRASH)
// -----------------------------------------------------------------------------
// Vector 1: Identificación de Spike vs Vela de Deriva
candle_body = math.abs(close - open)
candle_range = math.max(pip_size, high - low)

is_boom_spike = (close > open) and (candle_body >= pip_size * 20.0)
is_crash_spike = (close < open) and (candle_body >= pip_size * 20.0)
is_spike = is_boom ? is_boom_spike : (is_crash ? is_crash_spike : (candle_body >= ta.atr(14) * 2.5))

// Conteo de velas de deriva consecutivas desde el último spike
var int drift_count = 0
if is_spike
    drift_count := 0
else
    drift_count += 1

// Vector 2: Micro-Consolidación / Compresión de Rango (últimas 3 velas)
recent_3_range = math.max(high, high[1], high[2]) - math.min(low, low[1], low[2])
atr15 = ta.sma(high - low, 15)
is_micro_consolidation = (recent_3_range / math.max(pip_size, atr15 * 2.2)) < compression_threshold

// Vector 3: Mecha de Absorción Institucional
lower_wick = math.min(open, close) - low
upper_wick = high - math.max(open, close)
boom_rejection = ((lower_wick / candle_range) >= wick_threshold_pct) or (close > open)
crash_rejection = ((upper_wick / candle_range) >= wick_threshold_pct) or (close < open)
has_rejection = is_boom ? boom_rejection : (is_crash ? crash_rejection : (boom_rejection or crash_rejection))

// Vector 4: Tasa de Riesgo Acumulada de Weibull (Proximidad Cuántica)
drift_ratio = drift_count / avg_interval
weibull_prob = math.min(98.0, math.max(18.0, math.round(100.0 * (1.0 - math.exp(-math.pow(drift_ratio, 1.65))))))

// Vector 5: Condición Gatillo Sniper Cuántico ✓
sniper_trigger_boom = is_boom and (drift_count >= min_drift_req) and (has_rejection or is_micro_consolidation)
sniper_trigger_crash = is_crash and (drift_count >= min_drift_req) and (has_rejection or is_micro_consolidation)

// Tendencia en mercados generales (Forex / Cripto / Oro)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
rsi14 = ta.rsi(close, 14)
general_bull = is_general and (ema20 > ema50) and (close > ema20) and (rsi14 > 45) and (lower_wick / candle_range >= wick_threshold_pct)
general_bear = is_general and (ema20 < ema50) and (close < ema20) and (rsi14 < 55) and (upper_wick / candle_range >= wick_threshold_pct)

sniper_buy = (sniper_trigger_boom or general_bull) and enable_spike_hunter
sniper_sell = (sniper_trigger_crash or general_bear) and enable_spike_hunter

// Evitar repetición continua en velas consecutivas
var int last_trigger_bar = -100
can_trigger = (bar_index - last_trigger_bar) >= 3

confirmed_buy = sniper_buy and can_trigger
confirmed_sell = sniper_sell and can_trigger

if confirmed_buy or confirmed_sell
    last_trigger_bar := bar_index

// -----------------------------------------------------------------------------
// 4. ESCÁNER ARMÓNICO CUÁNTICO (XABCD & FIBONACCI PRZ)
// -----------------------------------------------------------------------------
ph = ta.pivothigh(high, zigzag_depth, zigzag_depth)
pl = ta.pivotlow(low, zigzag_depth, zigzag_depth)

var float pD = na
var float pC = na
var float pB = na
var float pA = na
var float pX = na

var int barD = na
var int barC = na
var int barB = na
var int barA = na
var int barX = na

var string detected_pattern = "Ninguno"
var bool harmonic_bull_active = false
var bool harmonic_bear_active = false

if not na(pl) and enable_harmonics
    pX := pB
    barX := barB
    pA := pC
    barA := barC
    pB := pD
    barB := barD
    pC := high[zigzag_depth]
    barC := bar_index[zigzag_depth]
    pD := low[zigzag_depth]
    barD := bar_index[zigzag_depth]

    if not na(pX) and not na(pA) and not na(pB) and not na(pC) and not na(pD)
        legXA = math.abs(pA - pX)
        legXD = math.abs(pD - pX)
        ratioXD = legXA > 0 ? (legXD / legXA) : 0.786

        if math.abs(ratioXD - 0.786) <= fibo_tolerance
            detected_pattern := "Gartley Alcista (0.786)"
            harmonic_bull_active := true
        else if math.abs(ratioXD - 0.886) <= fibo_tolerance
            detected_pattern := "Bat Alcista (0.886)"
            harmonic_bull_active := true
        else if ratioXD >= 1.15 and ratioXD <= 1.38
            detected_pattern := "Butterfly Alcista (1.272)"
            harmonic_bull_active := true
        else if ratioXD > 1.45 and ratioXD <= 1.75
            detected_pattern := "Crab Alcista (1.618)"
            harmonic_bull_active := true
        else
            harmonic_bull_active := false

if not na(ph) and enable_harmonics
    pX := pB
    barX := barB
    pA := pC
    barA := barC
    pB := pD
    barB := barD
    pC := low[zigzag_depth]
    barC := bar_index[zigzag_depth]
    pD := high[zigzag_depth]
    barD := bar_index[zigzag_depth]

    if not na(pX) and not na(pA) and not na(pB) and not na(pC) and not na(pD)
        legXA = math.abs(pA - pX)
        legXD = math.abs(pD - pX)
        ratioXD = legXA > 0 ? (legXD / legXA) : 0.786

        if math.abs(ratioXD - 0.786) <= fibo_tolerance
            detected_pattern := "Gartley Bajista (0.786)"
            harmonic_bear_active := true
        else if math.abs(ratioXD - 0.886) <= fibo_tolerance
            detected_pattern := "Bat Bajista (0.886)"
            harmonic_bear_active := true
        else if ratioXD >= 1.15 and ratioXD <= 1.38
            detected_pattern := "Butterfly Bajista (1.272)"
            harmonic_bear_active := true
        else if ratioXD > 1.45 and ratioXD <= 1.75
            detected_pattern := "Crab Bajista (1.618)"
            harmonic_bear_active := true
        else
            harmonic_bear_active := false

// -----------------------------------------------------------------------------
// 5. VISUALIZACIÓN SOBRE EL GRÁFICO (SEÑALES SNIPER & NIVELES TP/SL)
// -----------------------------------------------------------------------------
// Marcador Gatillo Sniper ✓
plotshape(confirmed_buy, title="Gatillo Sniper Compra ✓", style=shape.triangleup, location=location.belowbar, color=color.new(#00f2fe, 0), size=size.normal, text="SNIPER ✓", textcolor=color.new(#00f2fe, 0))
plotshape(confirmed_sell, title="Gatillo Sniper Venta ✓", style=shape.triangledown, location=location.abovebar, color=color.new(#ef4444, 0), size=size.normal, text="SNIPER ✓", textcolor=color.new(#ef4444, 0))

// Cajas de Posición y Proyección R:R ($50 USD Base)
tp1_dist = sl_points * 1.5
tp2_dist = sl_points * 2.2
tp3_dist = sl_points * 3.19

if (confirmed_buy or confirmed_sell) and show_target_boxes
    is_long = confirmed_buy
    entry_p = close
    sl_p = is_long ? (entry_p - sl_points) : (entry_p + sl_points)
    tp1_p = is_long ? (entry_p + tp1_dist) : (entry_p - tp1_dist)
    tp2_p = is_long ? (entry_p + tp2_dist) : (entry_p - tp2_dist)
    tp3_p = is_long ? (entry_p + tp3_dist) : (entry_p - tp3_dist)

    box_right = bar_index + 16

    // Caja de Beneficio (Cyan Neón)
    box.new(left=bar_index, top=is_long ? tp3_p : entry_p, right=box_right, bottom=is_long ? entry_p : tp3_p,
             bgcolor=color.new(#10b981, 88), border_color=color.new(#10b981, 20), border_width=1)

    // Caja de Riesgo (Rojo Neón)
    box.new(left=bar_index, top=is_long ? entry_p : sl_p, right=box_right, bottom=is_long ? sl_p : entry_p,
             bgcolor=color.new(#ef4444, 88), border_color=color.new(#ef4444, 20), border_width=1)

    // Etiquetas de Niveles de Precio y Ganancia / Pérdida en USD
    label.new(x=box_right, y=tp3_p, text="TP3 (1:3.19R): " + str.tostring(tp3_p, "#.##") + "\n+$9.57 USD (+4785 pips)",
              color=color.new(#065f46, 10), textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(x=box_right, y=tp1_p, text="TP1 (1:1.5R): " + str.tostring(tp1_p, "#.##") + "\n+$4.50 USD (+2250 pips)",
              color=color.new(#047857, 10), textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(x=box_right, y=sl_p, text="SL (1.0R): " + str.tostring(sl_p, "#.##") + "\n-$3.00 USD (-1500 pips)",
              color=color.new(#991b1b, 10), textcolor=color.white, style=label.style_label_left, size=size.small)

// Dibujar Triángulo Armónico X-A-B-C-D
var line lineXA = na
var line lineAB = na
var line lineBC = na
var line lineCD = na
var line lineXD = na

if (harmonic_bull_active or harmonic_bear_active) and not na(barD)
    if bar_index == barD + zigzag_depth
        line.delete(lineXA)
        line.delete(lineAB)
        line.delete(lineBC)
        line.delete(lineCD)
        line.delete(lineXD)

        color_harm = harmonic_bull_active ? color.new(#38bdf8, 20) : color.new(#f43f5e, 20)
        lineXA := line.new(barX, pX, barA, pA, color=color_harm, width=2, style=line.style_dashed)
        lineAB := line.new(barA, pA, barB, pB, color=color_harm, width=2)
        lineBC := line.new(barB, pB, barC, pC, color=color_harm, width=2)
        lineCD := line.new(barC, pC, barD, pD, color=color_harm, width=2)
        lineXD := line.new(barX, pX, barD, pD, color=color_harm, width=1, style=line.style_dotted)

        label.new(barD, pD, "PRZ " + detected_pattern, color=color.new(#1e1e24, 15), textcolor=color_harm, style=label.style_label_up, size=size.small)

// -----------------------------------------------------------------------------
// 6. PANEL HUD DE TELEMETRÍA CUÁNTICA EN VIVO (TRADINGVIEW PRO)
// -----------------------------------------------------------------------------
var table hud_table = table.new(position.top_right, 2, 8, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 30), border_width=1)

if barstate.islast and show_hud_table
    table.cell(hud_table, 0, 0, "AKIRA // TRADING LAB", bgcolor=color.new(#1e1b4b, 10), text_color=color.new(#a5b4fc, 0), text_size=size.small)
    table.cell(hud_table, 1, 0, "PRO V5.0", bgcolor=color.new(#1e1b4b, 10), text_color=color.new(#00f2fe, 0), text_size=size.small)

    table.cell(hud_table, 0, 1, "Mercado Activo", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud_table, 1, 1, is_boom ? "BOOM (Solo Compras)" : (is_crash ? "CRASH (Solo Ventas)" : "GENERAL"),
               text_color=is_boom ? #10b981 : (is_crash ? #ef4444 : #38bdf8), text_size=size.small)

    table.cell(hud_table, 0, 2, "Velas de Deriva", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud_table, 1, 2, str.tostring(drift_count) + " velas", text_color=color.white, text_size=size.small)

    table.cell(hud_table, 0, 3, "Proximidad Spike", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud_table, 1, 3, str.tostring(weibull_prob, "#") + "%",
               text_color=weibull_prob >= 80 ? #10b981 : (weibull_prob >= 50 ? #f59e0b : #ef4444), text_size=size.small)

    table.cell(hud_table, 0, 4, "Micro-Consolidación", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud_table, 1, 4, is_micro_consolidation ? "COMPRESIÓN ✓" : "NORMAL",
               text_color=is_micro_consolidation ? #10b981 : #64748b, text_size=size.small)

    table.cell(hud_table, 0, 5, "Absorción/Mecha", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud_table, 1, 5, has_rejection ? "DETECTADA ✓" : "ESPERANDO",
               text_color=has_rejection ? #00f2fe : #64748b, text_size=size.small)

    table.cell(hud_table, 0, 6, "Patrón Armónico", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud_table, 1, 6, detected_pattern, text_color=color.new(#c084fc, 0), text_size=size.small)

    table.cell(hud_table, 0, 7, "Cuenta Ref. / R:R", text_color=color.new(#94a3b8, 0), text_size=size.small)
    table.cell(hud_table, 1, 7, "$50 USD (1:3.19R)", text_color=color.new(#34d399, 0), text_size=size.small)

// -----------------------------------------------------------------------------
// 7. ALERTAS NATIVAS CONFIGURABLES PARA TRADINGVIEW PRO (WEBHOOK & PUSH)
// -----------------------------------------------------------------------------
alertcondition(confirmed_buy, title="⚡ Disparo Sniper Compra (Boom/General)", message="QuantickAkira: GATILLO SNIPER COMPRA CONFIRMADO en {{ticker}} a {{close}}.")
alertcondition(confirmed_sell, title="⚡ Disparo Sniper Venta (Crash/General)", message="QuantickAkira: GATILLO SNIPER VENTA CONFIRMADO en {{ticker}} a {{close}}.")
alertcondition(weibull_prob >= 90 and not is_spike, title="⚠️ Radar Spike Inminente (Proximidad >= 90%)", message="QuantickAkira: Radar de Spike Inminente (>90%) en {{ticker}} tras {{close}}.")

if confirmed_buy
    alert("⚡ QuantickAkira: Disparo Sniper Compra en " + syminfo.ticker + " a " + str.tostring(close), alert.freq_once_per_bar)
if confirmed_sell
    alert("⚡ QuantickAkira: Disparo Sniper Venta en " + syminfo.ticker + " a " + str.tostring(close), alert.freq_once_per_bar)
